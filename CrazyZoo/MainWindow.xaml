<Window x:Class="CrazyZoo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo"
        Height="900"
        Width="1400">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 Grid.Column="0"
                 Margin="5"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding FilteredAnimals}"
                 SelectedItem="{Binding SelectedAnimal}">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border BorderThickness="1"
                            Margin="3"
                            Padding="5">

                        <StackPanel>

                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Energy}"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="10">

                <TextBlock Text="Animal Details"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="5"/>

                <TextBlock Margin="5"
                           FontSize="16"
                           Text="{Binding SelectedAnimal.Name,
                                  StringFormat=Name: {0}}"/>

                <TextBlock Margin="5"
                           FontSize="16"
                           Text="{Binding SelectedAnimal.Energy,
                                  StringFormat=Energy: {0}}"/>

                <Button Content="Add Monkey"
                        Margin="5"
                        Command="{Binding AddMonkeyCommand}"/>

                <Button Content="Add Penguin"
                        Margin="5"
                        Command="{Binding AddPenguinCommand}"/>

                <Button Content="Add Lion"
                        Margin="5"
                        Command="{Binding AddLionCommand}"/>

                <Button Content="Add Tiger"
                        Margin="5"
                        Command="{Binding AddTigerCommand}"/>

                <Button Content="Add Bear"
                        Margin="5"
                        Command="{Binding AddBearCommand}"/>

                <Button Content="Add Wolf"
                        Margin="5"
                        Command="{Binding AddWolfCommand}"/>

                <Button Content="Add Fox"
                        Margin="5"
                        Command="{Binding AddFoxCommand}"/>

                <Button Content="Normal Action"
                        Margin="5"
                        Command="{Binding NormalActionCommand}"/>

                <Button Content="Crazy Action"
                        Margin="5"
                        Command="{Binding CrazyActionCommand}"/>

                <Button Content="Special Action"
                        Margin="5"
                        Command="{Binding SpecialActionCommand}"/>

                <Button Content="Remove Animal"
                        Margin="5"
                        Command="{Binding RemoveAnimalCommand}"/>

                <TextBlock Text="Statistics (GroupBy)"
                           FontWeight="Bold"
                           Margin="5,15,5,5"/>

                <ListBox Height="120"
                         ItemsSource="{Binding Statistics}"/>

                <TextBlock Text="Vol.3 Calculations"
                           FontWeight="Bold"
                           Margin="5,15,5,5"/>

                <TextBlock Text="Workload"
                           Margin="5"/>

                <TextBox Margin="5"
                         Text="{Binding Workload}" />

                <Button Content="Run Sequential"
                        Margin="5"
                        Command="{Binding RunSequentialCommand}"/>

                <Button Content="Run Parallel"
                        Margin="5"
                        Command="{Binding RunParallelCommand}"/>

                <Button Content="Cancel"
                        Margin="5"
                        Command="{Binding CancelCommand}"/>

                <TextBlock Margin="5"
                           FontWeight="Bold"
                           Text="{Binding ExecutionTime}" />

                <ListBox Height="250"
                         Margin="5"
                         ItemsSource="{Binding Results}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderThickness="1"
                                    Padding="4"
                                    Margin="2">

                                <StackPanel>

                                    <TextBlock Text="{Binding AnimalName}"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding Status}" />

                                    <TextBlock Text="{Binding Result,
                                                      StringFormat=Result: {0}}" />

                                    <TextBlock Text="{Binding Duration,
                                                      StringFormat=Time: {0}}" />

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>

        </ScrollViewer>

        <ListBox Grid.Row="2"
                 Grid.ColumnSpan="2"
                 Margin="5"
                 ItemsSource="{Binding Log}" />

    </Grid>

</Window>